<% content_for :title, "Messenger" %>

<div class="container messenger" data-controller="messenger"
     data-messenger-selected-value="<%= conversation_window_id(@conversation) if @conversation %>">
  <div class="row g-0 messenger-panel">
    <aside class="col-md-4 messenger-sidebar">
      <div class="messenger-sidebar-header">
        <h1 class="messenger-title">Messenger</h1>
        <%= link_to new_group_conversation_path, class: "new-group-link", title: "New group" do %>
          <i class="bi bi-people" aria-hidden="true"></i> New group
        <% end %>
      </div>
      <nav id="messenger-conversations" aria-label="Conversations" data-messenger-target="list">
        <%= render "messengers/conversations_list", menu: @menu, selected: @conversation %>
      </nav>
    </aside>

    <section class="col-md-8 messenger-main">
      <% if @conversation %>
        <%= render "messengers/conversation", conversation: @conversation %>
      <% else %>
        <div class="messenger-placeholder">
          <i class="bi bi-chat-square-text" aria-hidden="true"></i>
          <p>Start a conversation from someone's post, or create a group with your contacts, and it will show up here.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
