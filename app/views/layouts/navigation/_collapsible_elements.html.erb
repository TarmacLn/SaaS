<!-- Collect the nav links, forms, and other content for toggling -->
<div class="collapse navbar-collapse justify-content-end" id="navbar-collapsible-content">
  <ul class="navbar-nav">
    <% if user_signed_in? %>
      <li class="nav-item dropdown pc-menu d-none d-sm-block">
        <a id="user-settings" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
          <span id="user-name"><%= current_user.name %></span>
        </a>

        <ul class="dropdown-menu dropdown-menu-end">
          <li><%= link_to 'Edit Profile', edit_user_registration_path, class: 'dropdown-item' %></li>
          <li><%= link_to 'Log out', destroy_user_session_path, class: 'dropdown-item', data: { turbo_method: :delete } %></li>
        </ul>
      </li>

      <li class="nav-item mobile-menu d-sm-none">
        <%= link_to 'Edit Profile', edit_user_registration_path, class: 'nav-link' %>
      </li>
      <li class="nav-item mobile-menu d-sm-none">
        <%= link_to 'Log out', destroy_user_session_path, class: 'nav-link', data: { turbo_method: :delete } %>
      </li>

    <% else # user not signed in %>
      <li class="nav-item"><%= link_to 'Login', login_path, class: 'nav-link' %></li>
      <li class="nav-item"><%= link_to 'Signup', signup_path, class: 'nav-link' %></li>
    <% end # if user is signed in %>
  </ul>
</div><!-- navbar-collapse -->
