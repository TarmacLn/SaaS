<% if user_signed_in? %>
  <%# This user's own real-time stream (Action Cable): new messages and incoming conversations %>
  <%= turbo_stream_from current_user, :private_conversations %>
  <div id="incoming-messages" hidden></div>

  <%# The messenger page shows conversations full-size instead of in windows %>
  <% unless controller_name == "messengers" %>
    <ul id="conversations-windows" class="conversations-windows" data-controller="chat-windows">
      <% @private_conversations_windows.each do |conversation| %>
        <%= render partial: "private/conversations/conversation",
                   locals: { conversation: conversation, user: current_user } %>
      <% end %>
      <% @group_conversations_windows.each do |conversation| %>
        <%= render partial: "group/conversations/conversation",
                   locals: { conversation: conversation, user: current_user } %>
      <% end %>
    </ul>
  <% end %>
<% end %>
