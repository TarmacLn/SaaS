<% content_for :title, "New group" %>

<div class="container new-post group-form-page">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <%= link_to "← Back", :back, class: "back-link" %>
      <h1>New group</h1>

      <%= form_with model: @conversation, url: group_conversations_path, scope: :group_conversation, class: "post-form" do |f| %>
        <% if @conversation.errors.any? %>
          <div class="alert alert-danger"><%= @conversation.errors.full_messages.to_sentence %></div>
        <% end %>

        <div class="mb-3">
          <%= f.label :name, "Group name", class: "form-label" %>
          <%= f.text_field :name, class: "form-control", required: true, maxlength: 60,
                           placeholder: "E.g. Algorithms study group" %>
        </div>

        <%= render "group/conversations/contacts_checkboxes", contacts: @contacts,
                   legend: "Members (from your contacts)",
                   empty_text: "You need contacts to create a group. Add people from a conversation window." %>

        <%= f.submit "Create group", class: "btn btn-interested w-100", disabled: @contacts.empty? %>
      <% end %>
    </div>
  </div>
</div>
