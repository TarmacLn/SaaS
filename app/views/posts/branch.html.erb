<% content_for :title, branch_page_title(@branch) %>

<div id="branch-main-content" class="container branch-<%= @branch %>" data-controller="post-modal">
  <%= link_to "← Home", root_path, class: "back-link" %>

  <div class="branch-header">
    <h1 class="page-title"><%= branch_page_title(@branch) %></h1>
    <%= render create_new_post_partial_path, branch: @branch %>
  </div>

  <%= render "posts/branch/search_form", branch: @branch %>
  <%= render "posts/branch/categories", branch: @branch %>

  <div id="feed" class="row g-4">
    <%= render @posts %>
    <%= render no_posts_partial_path(@posts) %>
  </div><!-- row -->

  <%= render "shared/pagination", pagy: @pagy %>

  <%= render "posts/modal" %>
</div><!-- container -->
