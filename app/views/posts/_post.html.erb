<div class="col-12 col-sm-6 col-lg-4 single-post-card" id="<%= post_path(post.id) %>"
     role="button" tabindex="0" aria-haspopup="dialog"
     data-action="click->post-modal#open keydown.enter->post-modal#open">
  <article class="card post-card branch-<%= post.category.branch %>" data-branch="<%= post.category.branch %>">
    <div class="card-body">
      <span class="post-category"><%= post.category.name %></span>
      <h4 class="post-text">
        <%= truncate(post.title, length: 60) %>
      </h4>
      <p class="post-excerpt"><%= post.content %></p>
    </div>

    <footer class="post-meta">
      <span class="post-avatar" aria-hidden="true"><%= post_author_initial(post) %></span>
      <span class="post-author"><%= post.user.name %></span>
      <%= local_time_tag post.created_at, format: :title, class: "post-time",
                         text: "#{time_ago_in_words(post.created_at)} ago" %>
    </footer>

    <div class="post-content">
      <div class="posted-by">Posted by <%= post.user.name %> · <%= time_ago_in_words(post.created_at) %> ago</div>
      <h3><%= post.title %></h3>
      <p><%= post.content %></p>
      <div class="post-actions"><%= render post_card_actions_partial_path(post), post: post %></div>
    </div>
  </article><!-- card -->
</div><!-- single-post-card -->
