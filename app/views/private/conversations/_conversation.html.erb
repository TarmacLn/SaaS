<% recipient = private_conv_recipient(conversation) %>
<li class="conversation-window"
    id="<%= conversation_window_id(conversation) %>"
    data-pconversation-user-name="<%= recipient.name %>"
    data-controller="conversation-window"
    data-conversation-window-expanded-value="<%= local_assigns.fetch(:expanded, false) %>"
    data-conversation-window-mark-seen-url-value="<%= mark_as_seen_private_conversation_path(conversation) %>"
    data-action="click->conversation-window#markSeen"
    data-turbo-permanent>
  <div class="conversation-panel" data-pconversation-id="<%= conversation.id %>">
    <%= render "private/conversations/conversation/heading", conversation: conversation, recipient: recipient %>

    <!-- Conversation window's content -->
    <div class="conversation-body" data-conversation-window-target="body" hidden>
      <%= render "private/conversations/conversation/messages_list", conversation: conversation %>
      <%= render "private/conversations/conversation/new_message_form", conversation: conversation, user: user %>
    </div><!-- conversation-body -->
  </div>
</li><!-- conversation-window -->
