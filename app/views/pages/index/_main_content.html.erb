<div id="main-content" class="col-sm-9 <%= "branch-#{@branch}" if @branch %>">
  <div class="branch-header">
    <h1 class="page-title"><%= home_page_title %></h1>
    <%= render create_new_post_partial_path, branch: @branch %>
  </div>

  <%= render "pages/index/main_content/filters" %>

  <div id="feed" class="row g-4">
    <%= render @posts %>
    <%= render no_posts_partial_path(@posts) %>
  </div><!-- row -->

  <%= render "shared/pagination", pagy: @pagy %>
</div><!-- main-content -->
